APP_ENV=development
DATABASE_URL=sqlite:///./finpilot.db
FRONTEND_URL=http://localhost:3000
FRONTEND_ORIGIN_REGEX=^https://finpilot-[a-z0-9-]+-ishita22\.vercel\.app$
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=FinPilot <onboarding@resend.dev>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_APP_PASSWORD=
SMTP_USE_TLS=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_TIMEOUT_SECONDS=20
OPENAI_MAX_OUTPUT_TOKENS=900
DEMO_MODE=false
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_with_a_separate_webhook_secret
RAZORPAY_CLIENT_ID=replace_with_partner_development_client_id
RAZORPAY_CLIENT_SECRET=replace_with_partner_development_client_secret
RAZORPAY_REDIRECT_URI=http://127.0.0.1:8000/api/razorpay/oauth/callback
RAZORPAY_OAUTH_MODE=test
TOKEN_ENCRYPTION_KEY=generate_with_python_cryptography_fernet
SESSION_COOKIE_NAME=finpilot_session
SESSION_DAYS=30
